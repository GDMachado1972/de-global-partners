tSize=12;verticalAlign=middle;align=center;arcSize=8;shadow=0;" vertex="1" parent="1"><mxGeometry x="726" y="280" width="180" height="92" as="geometry"/></mxCell><mxCell id="athena" value="&lt;b&gt;Amazon Athena&lt;/b&gt;&lt;br/&gt;engine v3 + pyathena" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F7E3FB;strokeColor=#C925D1;fontColor=#1F2A37;fontSize=12;verticalAlign=middle;align=center;arcSize=8;shadow=0;" vertex="1" parent="1"><mxGeometry x="958" y="280" width="180" height="92" as="geometry"/></mxCell><mxCell id="serve" value="&lt;b&gt;Streamlit · App Runner&lt;/b&gt;&lt;br/&gt;6 dashboards · HTTPS" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCEBD9;strokeColor=#ED7100;fontColor=#1F2A37;fontSize=12;verticalAlign=middle;align=center;arcSize=8;shadow=0;" vertex="1" parent="1"><mxGeometry x="1190" y="280" width="180" height="92" as="geometry"/></mxCell><mxCell id="users" value="&lt;b&gt;Consumers&lt;/b&gt;&lt;br/&gt;Marketing · Ops · Strategy" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECEFF1;strokeColor=#566573;fontColor=#1F2A37;fontSize=12;verticalAlign=middle;align=center;arcSize=8;shadow=0;" vertex="1" parent="1"><mxGeometry x="1422" y="280" width="180" height="92" as="geometry"/></mxCell><mxCell id="band" value="&lt;b&gt;ORCHESTRATION — AWS Glue Workflow&lt;/b&gt;&lt;br/&gt;daily cron ~06:00 UTC · Triggers · Job Bookmarks (incremental) · retries · all transforms = PySpark on Glue ETL" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0EBFF;strokeColor=#7A3FF2;fontColor=#1F2A37;fontSize=12;verticalAlign=middle;align=left;arcSize=8;shadow=0;verticalAlign=top;spacingLeft=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="30" y="55" width="1592" height="60" as="geometry"/></mxCell><mxCell id="goldx" value="&lt;b&gt;Gold marts (grain)&lt;/b&gt;&lt;br/&gt;g_fact_customer_clv_daily — primary&lt;br/&gt;(user_id × snapshot_date)&lt;br/&gt;· g_dim_customer_rfm&lt;br/&gt;· g_fact_churn_indicators&lt;br/&gt;· g_fact_sales_trends&lt;br/&gt;· g_fact_loyalty_impact&lt;br/&gt;· g_fact_location_performance&lt;br/&gt;· g_fact_addon_revenue (optional)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF6DA;strokeColor=#B8912A;fontColor=#1F2A37;fontSize=12;verticalAlign=middle;align=left;arcSize=8;shadow=0;verticalAlign=top;spacingLeft=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="690" y="410" width="270" height="150" as="geometry"/></mxCell><mxCell id="note" value="&lt;b&gt;Cross-cutting guarantees&lt;/b&gt;&lt;br/&gt;Encryption — at rest: SSE-KMS (CMK) on all S3 zones, Glue, Athena results · in transit: TLS (JDBC encrypt=true) + HTTPS everywhere.&lt;br/&gt;Failure-reload — on failure: CloudWatch alarm → SNS alert; idempotent re-run overwrites only the batch_date partition (Delta ACID).&lt;br/&gt;Discount analysis — not feasible (no discount data); descoped per SME (D2).&lt;br/&gt;Data window — full order history 2020–2024; calendar generated in Silver (join coverage = 100%)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF9E8;strokeColor=#B8912A;fontColor=#1F2A37;fontSize=12;verticalAlign=middle;align=left;arcSize=8;shadow=0;verticalAlign=top;spacingLeft=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="990" y="410" width="632" height="150" as="geometry"/></mxCell><mxCell id="kms" value="&lt;b&gt;AWS KMS (CMK)&lt;/b&gt;&lt;br/&gt;at-rest SSE-KMS · all zones" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FBE4E7;strokeColor=#DD344C;fontColor=#1F2A37;fontSize=12;verticalAlign=middle;align=center;arcSize=8;shadow=0;" vertex="1" parent="1"><mxGeometry x="30" y="600" width="200" height="88" as="geometry"/></mxCell><mxCell id="secrets" value="&lt;b&gt;Secrets Manager&lt;/b&gt;&lt;br/&gt;SQL Server credentials" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FBE4E7;strokeColor=#DD344C;fontColor=#1F2A37;fontSize=12;verticalAlign=middle;align=center;arcSize=8;shadow=0;" vertex="1" parent="1"><mxGeometry x="260" y="600" width="200" height="88" as="geometry"/></mxCell><mxCell id="iam" value="&lt;b